# 프로덕션에서 traefik이 라우팅할 도메인 (로컬 개발에서는 비워둔다)
DOMAIN_NAME=ev.luftaquila.io

# Google OAuth (https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보)
# 승인된 리디렉션 URI에 <PUBLIC_URL>/auth/api/callback 을 반드시 등록해야 한다.
#   프로덕션: https://ev.luftaquila.io/auth/api/callback
#   로컬:     http://localhost:9000/auth/api/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://ev.luftaquila.io

# JWT & 서비스 간 인증 시크릿 (필수 — 프로덕션에서 미설정이면 서비스가 즉시 종료된다)
#   생성: openssl rand -hex 32
JWT_SECRET=
INTERNAL_SECRET=

# 기본 관리자 이메일. DB에 없으면 admin으로 자동 등록되며, 삭제·강등·비활성화가 금지된다.
ADMIN_EMAIL=

# 테스트 서버 모드
# - 백엔드: 모든 Google 로그인을 admin으로 자동 등록 (프로덕션에서 절대 켜지 말 것)
# - 프론트: 브랜드·탭 타이틀·파비콘에 ⚠️ TEST 표시
# TEST_SERVER=true
